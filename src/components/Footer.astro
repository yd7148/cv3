---
import { useT, type Locale } from "../lib/i18n";
const { locale } = Astro.props as { locale: Locale };
const t = useT(locale);
const y = new Date().getFullYear();
---

<footer class="footer-shell print-hide mt-24">
  <div class="container-x py-10">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <p class="gradient-text text-lg font-bold">
        {locale === "zh" ? "劉士禎" : "Shih-Chen Liu"}
      </p>
      <p class="text-sm text-dimmed">
        {t.hero.kicker} · {t.foot.rights} {y}
      </p>
    </div>
    <hr class="gradient-divider my-6" />
    <p class="text-xs text-dimmed">{t.foot.built}</p>
  </div>
</footer>
