    <style is:global>
      /* ---- 中英文並列版面 ---- */
      section[id] {
        scroll-margin-top: 5rem;
      }
      .bi-head {
        margin-bottom: 2.75rem;
        text-align: center;
      }
      .bi-rows {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
      .bi-pair {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
        align-items: stretch;
      }
      .bi-pair > * {
        height: 100%;
        min-width: 0;
      }
      @media (min-width: 900px) {
        .bi-pair {
          grid-template-columns: 1fr 1fr;
        }
        /* 左欄（中文）與右欄（英文）之間的分隔線 */
        .bi-pair > :first-child {
          border-right: 1px solid var(--border);
          padding-right: 1.5rem;
        }
        .bi-pair > :last-child {
          padding-left: 1.5rem;
        }
      }

      /* 主題切換（與 Header.astro 共用外觀） */
      .switch {
        position: relative;
        display: inline-block;
        width: 64px;
        height: 34px;
        flex-shrink: 0;
        cursor: pointer;
        transform: scale(0.75);
        filter: saturate(1.25) brightness(1.33);
        transition: filter 0.5s ease-in-out;
      }
      .switch:hover,
      .switch:focus-within {
        filter: saturate(1.5) brightness(1.5);
      }
      .switch:focus-within .slider {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
      .switch input {
        opacity: 0;
        width: 0;
        height: 0;
      }
      .slider {
        position: absolute;
        inset: 0;
        cursor: pointer;
        background-color: var(--bg-surface);
        transition: 0.4s;
        border-radius: 30px;
      }
      .slider::before {
        position: absolute;
        content: "";
        height: 26px;
        width: 26px;
        left: 4px;
        bottom: 4px;
        background-color: var(--text-muted);
        transition: 0.4s;
        border-radius: 50%;
      }
      .switch .sun svg {
        position: absolute;
        top: 6px;
        left: 36px;
        z-index: 1;
        width: 24px;
        height: 24px;
        animation: sw-rotate 30s linear infinite;
      }
      .switch .moon svg {
        fill: var(--text-muted);
        position: absolute;
        top: 5px;
        left: 5px;
        z-index: 1;
        width: 24px;
        height: 24px;
        animation: sw-tilt 5s linear infinite;
      }
      .switch .sun {
        display: block;
      }
      .switch .moon {
        display: none;
      }
      .switch:has(input:checked) .sun {
        display: none;
      }
      .switch:has(input:checked) .moon {
        display: block;
      }
      .switch input:checked + .slider {
        background-color: var(--bg-card);
      }
      .switch input:checked + .slider::before {
        transform: translateX(30px);
        background-color: var(--accent-blue);
      }
      @keyframes sw-rotate {
        0% {
          transform: rotate(0);
        }
        100% {
          transform: rotate(360deg);
        }
      }
      @keyframes sw-tilt {
        0%,
        100% {
          transform: rotate(0);
        }
        25% {
          transform: rotate(-10deg);
        }
        75% {
          transform: rotate(10deg);
        }
      }
    </style>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var key = root.dataset.themeKey || "portfolio-theme";
        var box = document.getElementById("theme-checkbox");
        var meta = document.getElementById("meta-theme-color");

        function apply(theme) {
          if (theme === "light") {
            root.setAttribute("data-theme", "light");
            if (box) box.checked = true;
            if (meta) meta.setAttribute("content", "#f8fafc");
          } else {
            root.removeAttribute("data-theme");
            if (box) box.checked = false;
            if (meta) meta.setAttribute("content", "#020617");
          }
        }
        try {
          apply(localStorage.getItem(key) || "dark");
        } catch (e) {}
        if (box) {
          box.addEventListener("change", function () {
            var t = box.checked ? "light" : "dark";
            try {
              localStorage.setItem(key, t);
            } catch (e) {}
            apply(t);
          });
        }

        if ("IntersectionObserver" in window) {
          var ro = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (en) {
                if (en.isIntersecting) {
                  en.target.classList.add("visible");
                  ro.unobserve(en.target);
                }
              });
            },
            { threshold: 0.08, rootMargin: "0px 0px -6% 0px" }
          );
          document.querySelectorAll(".reveal").forEach(function (el) {
            ro.observe(el);
          });
        } else {
          document.querySelectorAll(".reveal").forEach(function (el) {
            el.classList.add("visible");
          });
        }
      })();
    </script>
  </body>
