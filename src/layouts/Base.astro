---
import "../styles/global.css";
import { altPath, SITE_URL, type Locale } from "../lib/i18n";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  noindex?: boolean;
  navAnchors?: { href: string; label: string }[];
}

const { locale, title, description, noindex = false, navAnchors = [] } = Astro.props;
const path = Astro.url.pathname;
const alt = altPath(path, locale === "zh" ? "en" : "zh");
const abs = (p: string) => new URL(p, SITE_URL).href;

const anchors: { href: string; label: string }[] =
  navAnchors.length > 0
    ? navAnchors
    : [
        { href: `/${locale}/works/`, label: locale === "zh" ? "作品集" : "Projects" },
        { href: `/${locale}/notes/`, label: locale === "zh" ? "技術筆記" : "Notes" },
        { href: `/${locale}/resume/`, label: locale === "zh" ? "A4 履歷" : "Résumé" },
        { href: `/${locale}/about/`, label: locale === "zh" ? "關於" : "About" },
      ];
---

<!doctype html>
<html lang={locale === "zh" ? "zh-Hant-TW" : "en"} data-theme-key="portfolio-theme">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={abs(path)} />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <link rel="alternate" hreflang="zh-Hant-TW" href={abs(alt)} />
    <link rel="alternate" hreflang="en" href={abs(alt)} />
    <link rel="alternate" hreflang="x-default" href={abs("/zh/")} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#020617" id="meta-theme-color" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(path)} />
    <meta property="og:site_name" content="Shih-Chen Liu" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="author" content="劉士禎 / Shih-Chen Liu" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Noto+Sans+TC:wght@300;400;500;700;900&display=swap"
    />
    <script is:inline>
      // Applies the saved theme before first paint so there is no flash.
      (function () {
        try {
          var key = document.documentElement.dataset.themeKey || "portfolio-theme";
          if (localStorage.getItem(key) === "light") {
            document.documentElement.setAttribute("data-theme", "light");
            var m = document.getElementById("meta-theme-color");
            if (m) m.setAttribute("content", "#f8fafc");
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only">Skip to main content</a>

    <Header locale={locale} anchors={anchors} />

    <main id="main-content">
      <slot />
    </main>

    <Footer locale={locale} />

    <style is:global>
      .skip-link {
        position: absolute;
        top: -100%;
        left: 1rem;
        z-index: 9999;
        padding: 0.5rem 1rem;
        border-radius: 0 0 0.375rem 0.375rem;
        background: var(--accent);
        color: #fff;
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        transition: top 0.15s;
      }
      .skip-link:focus {
        top: 0;
      }
    </style>
  </body>
</html>
